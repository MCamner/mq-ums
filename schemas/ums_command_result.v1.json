{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mq.local/schemas/ums_command_result.v1.json",
  "title": "UMS command result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "request_id", "command_id", "section", "safety", "dry_run",
    "status", "started_at", "duration_ms", "source"
  ],
  "properties": {
    "schema": {"const": "ums_command_result.v1"},
    "request_id": {"type": "string", "minLength": 1},
    "command_id": {"type": "string", "minLength": 1},
    "section": {"type": "string", "minLength": 1},
    "safety": {"enum": ["read-only", "dangerous"]},
    "dry_run": {"type": "boolean"},
    "status": {"enum": ["success", "error", "dry-run"]},
    "started_at": {"type": "string", "format": "date-time"},
    "duration_ms": {"type": "integer", "minimum": 0},
    "source": {"enum": ["live", "cache", "dry-run"]},
    "cache_origin_request_id": {"type": "string", "minLength": 1},
    "data": {},
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1}
      }
    }
  }
}
