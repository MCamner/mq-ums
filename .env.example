# IGEL UMS server hostname or IP
MQ_UMS_HOST=your-ums-server.example.com

# UMS TCP port (default 8443)
MQ_UMS_PORT=8443

# Path to saved credential file (created by New-UmsCredential.ps1)
MQ_UMS_CRED_PATH=C:\mq-ums\ums.cred.xml

# Optional API key — leave empty to disable auth
MQ_UMS_API_KEY=

# Bind address — keep 127.0.0.1 unless you know what you are doing
MQ_UMS_BIND=127.0.0.1

# HTTP port for web UI and API
MQ_UMS_HTTP_PORT=8787
